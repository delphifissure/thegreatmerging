# The Plan — environment variables. Copy to .env.local for development. Never commit real values.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by jobs that run as the service role (bypasses RLS; every cross-user read is audited in lib/data).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for Drizzle (Supabase → Database → connection string, "transaction" pooler recommended for serverless)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Inngest. Local use: keep INNGEST_DEV=1 and run the dev server (npx inngest-cli@latest dev).
# Production: remove INNGEST_DEV and set both keys from app.inngest.com (Manage → Event Keys / Signing Key).
INNGEST_DEV=1
# INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=your-inngest-signing-key

# Application-level field encryption for PHQ-9, GAD-7, OCI-R values (AES-256-GCM).
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Public URL of the app (used in invitation and therapist-share links)
APP_URL=http://localhost:3000

# Optional. Set to "1" to send non-interactive LLM work (interpreter, summarizer, sentiment flagger, evals) through the Batches API.
LLM_USE_BATCH=1

# Optional. Clinician and research layer gates (section 11a). Leave unset in production until validated.
SENTIMENT_FLAGGER_ENABLED=0
OUTCOME_TRACKING_ENABLED=0
OUTCOME_COHORT_SALT=change-me

# Development and test only.
E2E_SEED=0
E2E_PASSWORD=the-plan-e2e
RUN_DB_TESTS=0
