{
  "key": "csi16",
  "name": "Couples Satisfaction Index (CSI-16)",
  "source_citation": "Funk & Rogge (2007). Testing the ruler with item response theory: increasing precision of measurement for relationship satisfaction with the Couples Satisfaction Index. Journal of Family Psychology, 21(4), 572–583.",
  "license_note": "Free for clinical and research use (Funk & Rogge 2007; the Rogge lab distributes the CSI without charge). Text transcribed from the CSI-32 as reproduced in the Fetzer Institute / Fincham self-report measures compilation, using the compilation's stated CSI-16 subset.",
  "layer": 1,
  "passes": [
    "single"
  ],
  "default_domain": "communication",
  "items": [
    {
      "item_id": "csi16_1",
      "text": "Please indicate the degree of happiness, all things considered, of your relationship.",
      "descriptor": "overall happiness",
      "scale": {
        "min": 0,
        "max": 6,
        "labels": [
          "Extremely Unhappy",
          "Fairly Unhappy",
          "A Little Unhappy",
          "Happy",
          "Very Happy",
          "Extremely Happy",
          "Perfect"
        ]
      },
      "reverse_scored": false,
      "domain": "communication",
      "csi32_item": 1
    },
    {
      "item_id": "csi16_2",
      "text": "In general, how often do you think that things between you and your partner are going well?",
      "descriptor": "things going well",
      "scale": {
        "min": 0,
        "max": 5,
        "labels": [
          "Never",
          "Rarely",
          "Occasionally",
          "More often than Not",
          "Most of the Time",
          "All the Time"
        ]
      },
      "reverse_scored": false,
      "domain": "communication",
      "csi32_item": 5,
      "printed_descending": true
    },
    {
      "item_id": "csi16_3",
      "text": "Our relationship is strong",
