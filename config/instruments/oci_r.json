{
  "key": "oci_r",
  "name": "Obsessive-Compulsive Inventory–Revised (OCI-R)",
  "source_citation": "Foa, Huppert, Leiberg, Langner, Kichic, Hajcak & Salkovskis (2002). The Obsessive-Compulsive Inventory: development and validation of a short version. Psychological Assessment, 14(4), 485–496.",
  "license_note": "Copyright Edna B. Foa 2002; freely reproduced for clinical and research use with citation of Foa et al. (2002).",
  "layer": 0,
  "passes": [
    "single"
  ],
  "mental_health": true,
  "items": [
    {
      "item_id": "oci_r_1",
      "text": "I have saved up so many things that they get in the way.",
      "descriptor": "hoarding item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_2",
      "text": "I check things more often than necessary.",
      "descriptor": "checking item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_3",
      "text": "I get upset if objects are not arranged properly.",
      "descriptor": "ordering item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_4",
      "text": "I feel compelled to count while I am doing things.",
      "descriptor": "neutralizing item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_5",
      "text": "I find it difficult to touch an object when I know it has been touched by strangers or certain people.",
      "descriptor": "washing item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_6",
      "text": "I find it difficult to control my own thoughts.",
      "descriptor": "obsessing item 1",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_7",
      "text": "I collect things I don’t need.",
      "descriptor": "hoarding item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_8",
      "text": "I repeatedly check doors, windows, drawers, etc.",
      "descriptor": "checking item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_9",
      "text": "I get upset if others change the way I have arranged things.",
      "descriptor": "ordering item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_10",
      "text": "I feel I have to repeat certain numbers.",
      "descriptor": "neutralizing item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_11",
      "text": "I sometimes have to wash or clean myself simply because I feel contaminated.",
      "descriptor": "washing item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_12",
      "text": "I am upset by unpleasant thoughts that come into my mind against my will.",
      "descriptor": "obsessing item 2",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_13",
      "text": "I avoid throwing things away because I am afraid I might need them later.",
      "descriptor": "hoarding item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_14",
      "text": "I repeatedly check gas and water taps and light switches after turning them off.",
      "descriptor": "checking item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_15",
      "text": "I need things to be arranged in a particular order.",
      "descriptor": "ordering item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_16",
      "text": "I feel that there are good and bad numbers.",
      "descriptor": "neutralizing item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_17",
      "text": "I wash my hands more often and longer than necessary.",
      "descriptor": "washing item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "oci_r_18",
      "text": "I frequently get nasty thoughts and have difficulty in getting rid of them.",
      "descriptor": "obsessing item 3",
      "scale": {
        "min": 0,
        "max": 4,
        "labels": [
          "Not at all",
          "A little",
          "Moderately",
          "A lot",
          "Extremely"
        ]
      },
      "reverse_scored": false
    }
  ],
