      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_16",
      "text": "It makes me mad that I don't get the affection and support I need from my partner.",
      "descriptor": "attachment anxiety item 16",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_17",
      "text": "I worry that I won't measure up to other people.",
