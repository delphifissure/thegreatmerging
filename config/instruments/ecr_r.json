{
  "key": "ecr_r",
  "name": "Experiences in Close Relationships–Revised (ECR-R)",
  "source_citation": "Fraley, Waller & Brennan (2000). An item response theory analysis of self-report measures of adult attachment. Journal of Personality and Social Psychology, 78(2), 350–365.",
  "license_note": "Distributed without charge on R. Chris Fraley's lab page for research and clinical use; cite Fraley, Waller & Brennan (2000). The page carries no further permission statement.",
  "layer": 0,
  "passes": [
    "single"
  ],
  "items": [
    {
      "item_id": "ecr_r_1",
      "text": "I'm afraid that I will lose my partner's love.",
      "descriptor": "attachment anxiety item 1",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_2",
      "text": "I often worry that my partner will not want to stay with me.",
      "descriptor": "attachment anxiety item 2",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_3",
      "text": "I often worry that my partner doesn't really love me.",
      "descriptor": "attachment anxiety item 3",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_4",
      "text": "I worry that romantic partners won't care about me as much as I care about them.",
      "descriptor": "attachment anxiety item 4",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_5",
      "text": "I often wish that my partner's feelings for me were as strong as my feelings for him or her.",
      "descriptor": "attachment anxiety item 5",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_6",
      "text": "I worry a lot about my relationships.",
      "descriptor": "attachment anxiety item 6",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_7",
      "text": "When my partner is out of sight, I worry that he or she might become interested in someone else.",
      "descriptor": "attachment anxiety item 7",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_8",
      "text": "When I show my feelings for romantic partners, I'm afraid they will not feel the same about me.",
      "descriptor": "attachment anxiety item 8",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_9",
      "text": "I rarely worry about my partner leaving me.",
      "descriptor": "attachment anxiety item 9",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": true
    },
    {
      "item_id": "ecr_r_10",
      "text": "My romantic partner makes me doubt myself.",
      "descriptor": "attachment anxiety item 10",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_11",
      "text": "I do not often worry about being abandoned.",
      "descriptor": "attachment anxiety item 11",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": true
    },
    {
      "item_id": "ecr_r_12",
      "text": "I find that my partner(s) don't want to get as close as I would like.",
      "descriptor": "attachment anxiety item 12",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_13",
      "text": "Sometimes romantic partners change their feelings about me for no apparent reason.",
      "descriptor": "attachment anxiety item 13",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_14",
      "text": "My desire to be very close sometimes scares people away.",
      "descriptor": "attachment anxiety item 14",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_15",
      "text": "I'm afraid that once a romantic partner gets to know me, he or she won't like who I really am.",
