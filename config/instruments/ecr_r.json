        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_20",
      "text": "I feel comfortable sharing my private thoughts and feelings with my partner.",
