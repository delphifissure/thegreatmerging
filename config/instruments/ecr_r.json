      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_18",
      "text": "My partner only seems to notice me when I'm angry.",
      "descriptor": "attachment anxiety item 18",
      "scale": {
        "min": 1,
        "max": 7,
        "labels": [
          "Strongly disagree",
          "",
          "",
          "",
          "",
          "",
          "Strongly agree"
        ]
      },
      "reverse_scored": false
    },
    {
      "item_id": "ecr_r_19",
      "text": "I prefer not to show a partner how I feel deep down.",
